    tool_summary: "Create BinaryInspector.tsx"
    tool_action: "Creating BinaryInspector component"
    started_at {
      seconds: 1780251431
      nanos: 392646050
    }
  }
  file_change {
    absolute_path_uri: "file:///src/components/BinaryInspector.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { \n  FileCode, CheckCircle2, AlertTriangle, Cpu, HelpCircle, Eye, \n  Terminal, Server, Code, FileCode2, Package, RefreshCw, Smartphone\n} from \"lucide-react\";\nimport { DecompiledClass, IpaMetadata } from \"../types\";\n\ninterface BinaryInspectorProps {\n  metadata: IpaMetadata;\n  onSelectSnippet: (snippet: string) => void;\n  activeClass: DecompiledClass | null;\n  setActiveClass: (c: DecompiledClass | null) => void;\n}\n\nexport const BinaryInspector: React.FC<BinaryInspectorProps> = ({\n  metadata,\n  onSelectSnippet,\n  activeClass,\n  setActiveClass\n}) => {\n  const [searchQuery, setSearchQuery] = React.useState(\"\");\n\n  const filteredClasses = metadata.classes.filter(c => \n    c.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    c.methods.some(m => m.name.toLowerCase().includes(searchQuery.toLowerCase())) ||\n    c.properties.some(p => p.name.toLowerCase().includes(searchQuery.toLowerCase()))\n  );\n\n  const generateLogosHook = (className: string, method: any) => {\n    let argsString = \"\";\n    if (method.arguments && method.arguments.length > 0) {\n      argsString = method.arguments.map((arg: any) => `(${arg.type})${arg.name}`).join(\" \");\n    }\n    \n    const methodSignature = `${method.returnType === \"void\" ? \"-\" : \"- \"}(${method.returnType})${method.name}${argsString}`;\n    let body = \"\";\n    if (method.returnType === \"BOOL\") {\n      body = \"return %orig; // or return NO; to bypass\";\n    } else if (method.returnType === \"void\") {\n      body = \"%orig;\\n    // execute custom logic\";\n    } else {\n      body = \"return %orig;\";\n    }\n\n    return `%hook ${className}\\n\\n${methodSignature} {\\n    ${body}\\n}\\n\\n%end`;\n  };\n\n  const generateSwiftHook = (className: string, method: any) => {\n    let argsString = \"\";\n    if (method.arguments && method.arguments.length > 0) {\n      argsString = method.arguments.map((arg: any) => `_ ${arg.name}: ${arg.type.replace(\" *\", \"\")}`).join(\", \");\n    }\n    \n    return `@objc class Hook_${className} : NSObject {\\n    @objc func ${method.name.replace(\":\", \"\")}(${argsString}) -> ${method.returnType} {\\n        // Your Swift Substrate Override\\n        return false\\n    }\\n}`;\n  };\n\n  return (\n    <div className=\"flex flex-col h-full bg-[#161b22] border border-gray-800 rounded-lg overflow-hidden\">\n      {/* Header Info */}\n      <div className=\"p-4 bg-[#0d1117] border-b border-gray-800\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <div className=\"flex items-center gap-2\">\n            <Smartphone className=\"w-5 h-5 text-indigo-400\" />\n            <h3 className=\"font-mono text-sm font-semibold text-gray-200\">\n              {metadata.displayName}\n            </h3>\n          </div>\n          <span className=\"px-2 py-0.5 rounded-full text-[11px] font-mono bg-indigo-950 text-indigo-300 border border-indigo-900\">\n            {metadata.bundleIdentifier}\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 gap-2 text-xs font-mono text-gray-400 mt-3 pt-2 border-t border-gray-900\">\n          <div>\n            <span className=\"text-gray-500\">File size:</span> {metadata.fileSize}\n          </div>\n          <div>\n            <span className=\"text-gray-500\">Min OS:</span> iOS {metadata.minimumOSVersion}\n          </div>\n          <div>\n            <span className=\"text-gray-500\">Architecture:</span> {metadata.architecture.join(\", \")}\n          </div>\n          <div>\n            <span className=\"text-gray-500\">SDK Version:</span> {metadata.sdkVersion}\n          </div>\n        </div>\n      </div>\n\n      {/* Two Pane Header Search */}\n      <div className=\"p-3 bg-[#161b22] border-b border-gray-800\">\n        <div className=\"relative\">\n          <input\n            type=\"text\"\n            placeholder=\"Search class-dump symbols...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full pl-3 pr-8 py-1.5 rounded bg-[#0d1117] border border-gray-800 text-xs font-mono text-gray-300 placeholder-gray-500 focus:outline-none focus:border-indigo-500\"\n          />\n          {searchQuery && (\n            <button \n              onClick={() => setSearchQuery(\"\")}\n              className=\"absolute right-2 top-1.5 text-gray-500 hover:text-gray-300 text-xs\"\n            >\n              \303\227\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Pane Content */}\n      <div className=\"flex flex-1 min-h-0 divide-x divide-gray-800\">\n        {/* Classes List */}\n        <div className=\"w-1/2 overflow-y-auto p-2 space-y-1\">\n          <div className=\"px-2 py-1 text-[11px] font-mono font-bold text-gray-500 uppercase tracking-wider\">\n            Decompiled Classes ({filteredClasses.length})\n          </div>\n          {filteredClasses.length === 0 ? (\n            <div className=\"p-3 text-xs text-gray-500 font-mono text-center\">\n              No matching class dumps.\n            </div>\n          ) : (\n            filteredClasses.map((item) => (\n              <button\n                key={item.name}\n                onClick={() => setActiveClass(item)}\n                className={`w-full text-left p-2 rounded font-mono text-xs transition-colors flex flex-col gap-1 ${\n                  activeClass?.name === item.name \n                    ? \"bg-indigo-950/40 text-indigo-200 border-l-2 border-indigo-500\" \n                    : \"text-gray-300 hover:bg-[#21262d]\"\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-semibold\">{item.name}</span>\n                  <span className=\"text-[10px] text-gray-500\">{item.superClass}</span>\n                </div>\n                {item.protocols && item.protocols.length > 0 && (\n                  <div className=\"text-[10px] text-gray-500 truncate\">\n                    &lt;{item.protocols.join(\", \")}&gt;\n                  </div>\n                )}\n              </button>\n            ))\n          )}\n        </div>\n\n        {/* Selected Class Details & Hooks helper */}\n        <div className=\"w-1/2 overflow-y-auto p-4\">\n          {activeClass ? (\n            <div className=\"space-y-4\">\n              <div>\n                <div className=\"text-[10px] font-mono text-indigo-400 font-semibold mb-1\">\n                  @interface\n                </div>\n                <h4 className=\"font-mono text-sm font-bold text-gray-200\">\n                  {activeClass.name} : {activeClass.superClass}\n                </h4>\n              </div>\n\n              {/* Properties */}\n              {activeClass.properties.length > 0 && (\n                <div>\n                  <div className=\"text-[10px] font-mono text-gray-500 font-bold uppercase tracking-wider mb-2\">\n                    Properties ({activeClass.properties.length})\n                  </div>\n                  <div className=\"bg-[#0d1117] p-2 rounded border border-gray-800 divide-y divide-gray-905 space-y-2 max-h-40 overflow-y-auto\">\n                    {activeClass.properties.map((prop) => (\n                      <div key={prop.name} className=\"py-1 font-mono text-xs flex flex-col\">\n                        <span className=\"text-gray-300\">{prop.type} <span className=\"text-indigo-300\">{prop.name}</span></span>\n                        <span className=\"text-[9px] text-gray-500\">attributes: ({prop.attributes.join(\", \")})</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Methods & Fast Hook Inject */}\n              <div className=\"space-y-2\">\n                <div className=\"text-[10px] font-mono text-gray-500 font-bold uppercase tracking-wider\">\n                  Methods ({activeClass.methods.length})\n                </div>\n                <div className=\"space-y-2\">\n                  {activeClass.methods.map((method) => (\n                    <div \n                      key={method.name} \n                      className=\"p-2.5 rounded bg-[#0d1117] border border-gray-800 font-mono text-xs space-y-2\"\n                    >\n                      <div className=\"flex items-start justify-between\">\n                        <div className=\"text-gray-300 break-all font-medium\">\n                          {method.returnType === \"void\" ? \"-\" : \"- \"}({method.returnType}){method.name}\n                          {method.arguments.map(arg => `(${arg.type})${arg.name}`).join(\" \")}\n                        </div>\n                      </div>\n                      \n                      {method.notes && (\n                        <p className=\"text-[10px] text-yellow-400 bg-yellow-905/20 p-1.5 rounded\">\n                          {method.notes}\n                        </p>\n                      )}\n\n                      <div className=\"flex gap-1.5 border-t border-gray-900 pt-2 mt-1\">\n                        <button\n                          onClick={() => onSelectSnippet(generateLogosHook(activeClass.name, method))}\n                          className=\"flex-1 py-1 px-1.5 rounded bg-indigo-950 hover:bg-indigo-900 text-indigo-300 border border-indigo-900 text-[10px] flex items-center justify-center gap-1 transition-all\"\n                          title=\"Generate Logos template code and inject in editor\"\n                        >\n                          <Code className=\"w-3\" /> Logos Hook\n                        </button>\n                        <button\n                          onClick={() => onSelectSnippet(generateSwiftHook(activeClass.name, method))}\n                          className=\"flex-1 py-1 px-1.5 rounded bg-[#21262d] hover:bg-[#30363d] text-gray-300 border border-gray-800 text-[10px] flex items-center justify-center gap-1 transition-all\"\n                          title=\"Generate Swift wrapper code and inject in editor\"\n                        >\n                          <FileCode className=\"w-3\" /> Swift Hook\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"h-full flex flex-col items-center justify-center text-center text-gray-500 font-mono text-xs\">\n              <Cpu className=\"w-8 h-8 text-indigo-500 mb-2 opacity-50\" />\n              Select a decompiled class from the left lists to inspect header structure, variables, and generate quick Theos tweak hooks.\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
