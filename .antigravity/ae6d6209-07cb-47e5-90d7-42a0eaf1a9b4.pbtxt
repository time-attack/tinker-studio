  file_change {
    absolute_path_uri: "file:///src/components/IpaSelector.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { \n  Upload, Terminal, HelpCircle, FileText, CheckCircle2, \n  Cpu, Smartphone, Database, AlertCircle, Sparkles, BookOpen, Layers\n} from \"lucide-react\";\n\ninterface IpaSelectorProps {\n  onIpaLoaded: (metadata: any) => void;\n  isLoading: boolean;\n  setIsLoading: (val: boolean) => void;\n  activeIpaName: string;\n}\n\nexport const IpaSelector: React.FC<IpaSelectorProps> = ({\n  onIpaLoaded,\n  isLoading,\n  setIsLoading,\n  activeIpaName\n}) => {\n  const [templates, setTemplates] = React.useState<any[]>([]);\n  const [selectedTemplateKey, setSelectedTemplateKey] = React.useState(\"YouTube.ipa\");\n  const [manualFileName, setManualFileName] = React.useState(\"\");\n  const [dragActive, setDragActive] = React.useState(false);\n\n  React.useEffect(() => {\n    fetch(\"/api/templates\")\n      .then(res => res.json())\n      .then(data => setTemplates(data || []))\n      .catch(err => console.error(\"Could not fetch sample templates\", err));\n  }, []);\n\n  const triggerAnalyze = (fileName: string, templateKey: string) => {\n    setIsLoading(true);\n    fetch(\"/api/analyze-ipa\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        fileName: fileName,\n        selectedTemplate: templateKey\n      })\n    })\n      .then(res => res.json())\n      .then(data => {\n        if (data.metadata) {\n          onIpaLoaded(data.metadata);\n        }\n      })\n      .catch(err => console.error(err))\n      .finally(() => setIsLoading(false));\n  };\n\n  const handleTemplateChange = (e: React.ChangeEvent<HTMLSelectElement>) => {\n    const key = e.target.value;\n    setSelectedTemplateKey(key);\n    triggerAnalyze(key, key);\n  };\n\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      const file = e.dataTransfer.files[0];\n      if (file.name.endsWith(\".ipa\")) {\n        setManualFileName(file.name);\n        triggerAnalyze(file.name, selectedTemplateKey);\n      } else {\n        alert(\"Please drop a valid .ipa file extension.\");\n      }\n    }\n  };\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      const file = e.target.files[0];\n      setManualFileName(file.name);\n      triggerAnalyze(file.name, selectedTemplateKey);\n    }\n  };\n\n  return (\n    <div className=\"bg-[#161b22] border border-gray-800 rounded-lg p-5 space-y-4\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 pb-3 border-b border-gray-800\">\n        <div>\n          <h2 className=\"text-base font-mono font-bold text-gray-200 flex items-center gap-2\">\n            <Smartphone className=\"w-5 h-5 text-indigo-400\" />\n            1. Target App .ipa Selection\n          </h2>\n          <p className=\"text-xs text-gray-400 font-mono mt-1\">\n            Upload custom decrypted IPA packages, or select matching binary simulations to explore class-dumps.\n          </p>\n        </div>\n\n        {/* Dropdown of Templates */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <label className=\"text-xs font-mono text-gray-401 whitespace-nowrap\">Load Preset Binary:</label>\n          <select\n            value={selectedTemplateKey}\n            onChange={handleTemplateChange}\n            className=\"bg-[#0d1117] border border-gray-800 text-xs font-mono text-gray-300 rounded px-3 py-1.5 focus:outline-none focus:border-indigo-500\"\n          >\n            {templates.map((t) => (\n              <option key={t.key} value={t.key}>\n                {t.name} ({t.fileSize})\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {/* Drag & Drop Simulation Zone */}\n      <div\n        onDragEnter={handleDrag}\n        onDragOver={handleDrag}\n        onDragLeave={handleDrag}\n        onDrop={handleDrop}\n        className={`relative border-2 border-dashed rounded-lg p-6 py-8 text-center transition-all ${\n          dragActive \n            ? \"border-indigo-500 bg-indigo-950/10\" \n            : \"border-gray-800 bg-[#0d1117]/60 hover:bg-[#0d1117]/90 hover:border-gray-700\"\n        }`}\n      >\n        <input\n          type=\"file\"\n          accept=\".ipa\"\n          onChange={handleFileSelect}\n          className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n        />\n\n        <div className=\"flex flex-col items-center justify-center space-y-2\">\n          {isLoading ? (\n            <div className=\"space-y-3\">\n              <Cpu className=\"w-10 h-10 text-emerald-400 animate-spin mx-auto\" />\n              <div className=\"space-y-1\">\n                <p className=\"text-xs font-mono font-semibold text-emerald-400 animate-pulse\">\n                  Simulating complete binary Header extraction (class-dump)...\n                </p>\n                <p className=\"text-[10px] text-gray-500 font-mono\">\n                  Loading mach_header_64 structs, decrypting payload app wrappers, index dynamic classes...\n                </p>\n              </div>\n            </div>\n          ) : activeIpaName ? (\n            <div className=\"space-y-2\">\n              <CheckCircle2 className=\"w-10 h-10 text-emerald-500 mx-auto\" />\n              <div>\n                <p className=\"text-xs font-mono font-bold text-gray-200\">\n                  Successfully analyzed & class-dumped: <span className=\"text-emerald-400\">{activeIpaName}</span>\n                </p>\n                <p className=\"text-[10px] text-gray-500 font-mono mt-1\">\n                  Ready to inspect symbols, methods, declare hooking rules, or compile tweak framework dylibs.\n                </p>\n              </div>\n            </div>\n          ) : (\n            <>\n              <Upload className=\"w-10 h-10 text-gray-500 mx-auto\" />\n              <p className=\"text-xs font-mono text-gray-300 font-semibold\">\n                Drag and Drop decrypted <span className=\"text-indigo-400\">.ipa</span> file here\n              </p>\n              <p className=\"text-[10px] text-gray-500 font-mono\">\n                Supports up to 500MB decrypted ARM64 packages. Automatic binary parsing kicks in instantly.\n              </p>\n            </>\n          )}\n        </div>\n      </div>\n\n      {/* Security note / header explanation */}\n      <div className=\"bg-[#1c1212]/30 border border-amber-950/40 p-3 rounded-lg flex items-start gap-3\">\n        <AlertCircle className=\"w-4 h-4 text-amber-500 shrink-0 mt-0.5\" />\n        <div className=\"text-[11px] font-mono text-amber-400 leading-relaxed\">\n          <strong className=\"text-amber-300\">Security Sandbox note:</strong> Decrypted IPAs are automatically de-packaged, dynamic classes parsed, and Substrate hooks linked using thin Mach-O patching wrappers. Use the class browser on the side or the AI agent to automate Logos code injection blocks.\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
