  file_change {
    absolute_path_uri: "file:///src/components/TweakChat.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Send, Cpu, Terminal, Sparkles, MessageSquare, ShieldAlert } from \"lucide-react\";\nimport { ChatMessage, IpaMetadata } from \"../types\";\n\ninterface TweakChatProps {\n  chatHistory: ChatMessage[];\n  onSendMessage: (message: string) => void;\n  isLoading: boolean;\n  activeIpa: IpaMetadata | null;\n}\n\nexport const TweakChat: React.FC<TweakChatProps> = ({\n  chatHistory,\n  onSendMessage,\n  isLoading,\n  activeIpa\n}) => {\n  const [inputText, setInputText] = React.useState(\"\");\n  const chatEndRef = React.useRef<HTMLDivElement>(null);\n\n  React.useEffect(() => {\n    if (chatEndRef.current) {\n      chatEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [chatHistory, isLoading]);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inputText.trim() || isLoading) return;\n    onSendMessage(inputText);\n    setInputText(\"\");\n  };\n\n  const getSuggestedPrompts = () => {\n    const name = activeIpa?.displayName || \"TargetApp\";\n    return [\n      { label: `Bypass Jailbreak Check`, text: `Hook ${name}\'s main view controller and disable the jailbreak detection check.` },\n      { label: `Override Premium Status`, text: `Identify license verification properties inside ${name} classes and force them to return YES.` },\n      { label: `Disable Advertisements`, text: `Locate ad presentation methods and hook them to early exit / bypass rendering.` }\n    ];\n  };\n\n  return (\n    <div className=\"flex flex-col h-full bg-[#161b22] border border-gray-800 rounded-lg overflow-hidden\">\n      {/* Header Info */}\n      <div className=\"p-3.5 bg-[#0d1117] border-b border-gray-800 flex items-center justify-between shrink-0\">\n        <div className=\"flex items-center gap-2\">\n          <MessageSquare className=\"w-4 h-4 text-indigo-400\" />\n          <span className=\"font-mono text-xs font-semibold text-gray-200\">\n            Interactive Patch Assistant\n          </span>\n        </div>\n        <span className=\"text-[10px] bg-indigo-950 text-indigo-300 border border-indigo-900 px-1.5 py-0.5 rounded font-mono\">\n          Substrate Coach\n        </span>\n      </div>\n\n      {/* Chat History Messages */}\n      <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-[#0d1117]/30\">\n        {chatHistory.length === 0 ? (\n          <div className=\"h-full flex flex-col justify-center items-center max-w-sm mx-auto text-center space-y-4 my-auto\">\n            <div className=\"p-3 bg-indigo-950/40 rounded-full border border-indigo-900 text-indigo-400\">\n              <Sparkles className=\"w-6 h-6 animate-pulse\" />\n            </div>\n            \n            <div className=\"space-y-1\">\n              <h4 className=\"font-mono text-xs font-semibold text-gray-200\">Design Tweak Code Conversationalists</h4>\n              <p className=\"text-[11px] text-gray-400 font-mono leading-relaxed\">\n                Prompt the agent to hook properties, override booleans, or rewrite selectors. The dynamic editor will sync instantly.\n              </p>\n            </div>\n\n            {/* Dynamic Suggestions Grid */}\n            <div className=\"grid grid-cols-1 gap-1.5 w-full pt-1\">\n              <span className=\"text-[9px] text-gray-500 font-bold uppercase tracking-wider text-left pl-1\">\n                Suggested Patches for {activeIpa?.displayName || \"Target App\"}\n              </span>\n              {getSuggestedPrompts().map((s) => (\n                <button\n                  key={s.label}\n                  onClick={() => setInputText(s.text)}\n                  className=\"p-2.5 bg-[#161b22] hover:bg-[#21262d] border border-gray-800 hover:border-gray-750 rounded text-left font-mono text-[10px] text-gray-300 transition-all flex flex-col gap-0.5\"\n                >\n                  <span className=\"font-semibold text-indigo-300\">{s.label}</span>\n                  <span className=\"text-gray-500 line-clamp-1\">{s.text}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            {chatHistory.map((msg) => (\n              <div\n                key={msg.id}\n                className={`flex flex-col max-w-[85%] ${\n                  msg.role === \"user\" ? \"ml-auto items-end\" : \"mr-auto items-start\"\n                }`}\n              >\n                <div\n                  className={`p-3 rounded text-xs font-mono leading-relaxed select-text ${\n                    msg.role === \"user\"\n                      ? \"bg-indigo-600 text-white rounded-br-none\"\n                      : \"bg-[#161b22] border border-gray-800 text-gray-200 rounded-bl-none\"\n                  }`}\n                >\n                  {msg.content}\n                </div>\n\n                {/* Substrate Analysis terminal simulation inside assistant messages */}\n                {msg.role === \"assistant\" && msg.commandRun && msg.commandRun.command && (\n                  <div className=\"w-full mt-1.5 p-2 rounded bg-black/40 border border-gray-800 font-mono text-[10px] text-gray-400\">\n                    <div className=\"flex items-center gap-1.5 text-[9px] text-indigo-400 pb-1 border-b border-gray-900 mb-1\">\n                      <Terminal className=\"w-3.5 h-3.5\" /> class-dump parser output\n                    </div>\n                    <div className=\"text-gray-300\">$ {msg.commandRun.command}</div>\n                    <pre className=\"mt-1 text-gray-500 max-h-20 overflow-y-auto whitespace-pre-wrap select-text leading-tight\">\n                      {msg.commandRun.output}\n                    </pre>\n                  </div>\n                )}\n                \n                <span className=\"text-[9px] text-gray-600 mt-1 font-mono\">{msg.timestamp}</span>\n              </div>\n            ))}\n\n            {isLoading && (\n              <div className=\"mr-auto max-w-[85%] flex flex-col items-start gap-2\">\n                <div className=\"p-3 rounded bg-[#161b22] border border-gray-800 text-xs font-mono text-gray-400 rounded-bl-none flex items-center gap-2\">\n                  <Cpu className=\"w-3.5 h-3.5 text-indigo-400 animate-spin\" />\n                  Generating class-dump filters & constructing Substrate hook overrides...\n                </div>\n              </div>\n            )}\n            \n            <div ref={chatEndRef} />\n          </div>\n        )}\n      </div>\n\n      {/* Input Message Form */}\n      <form onSubmit={handleSubmit} className=\"p-3 bg-[#0d1117] border-t border-gray-800 shrink-0\">\n        <div className=\"flex items-center gap-2\">\n          <input\n            type=\"text\"\n            placeholder={\n              !activeIpa \n                ? \"Upload or enter an App name to interact...\" \n                : `Command patches on ${activeIpa.displayName}...`\n            }\n            disabled={!activeIpa || isLoading}\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            className=\"flex-1 bg-[#161b22] border border-gray-800 rounded px-3 py-2 text-xs font-mono text-gray-300 placeholder-gray-500 focus:outline-none focus:border-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!activeIpa || !inputText.trim() || isLoading}\n            className=\"p-2 rounded bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-50 disabled:cursor-not-allowed transition-all shrink-0 cursor-pointer\"\n          >\n            <Send className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
    }
