      target_content: "app.post(\"/api/chat\", async (req, res) => {\n  const { message, chatHistory, ipaMetadata, tweakCode, tweakLanguage } = req.body;\n  \n  try {\n    const systemPrompt = `You are a highly skilled veteran iOS security researcher and dynamic binary manipulation developer.\nYou have absolute expertise working with Mobile Substrate hooking frameworks, LLDB debugging, cycript, and Logos syntax (declarative %hook, %orig, %end, %ctor).\nThe user is working on decompiling and injecting tweaks into an iOS application package (.ipa).\nCurrent Target App Metadata: ${JSON.stringify(ipaMetadata || {}, null, 2)}\nCurrent Active Code in Editor:\n${tweakCode || \"// Code is empty.\"}\n\nBEHAVIOR RULES:\n- You must always respond in JSON following this absolute schema:\n{\n  \"explanation\": \"A focused, veteran explanation detailing the specific substrate hook or manipulation.\",\n  \"commandRun\": { \"command\": \"grep or class-dump simulation query\", \"output\": \"results retrieved during analysis\" },\n  \"tweakCode\": \"The fully integrated updated tweak code. Do not write duplicate %hook blocks. Maintain and patch the active code in place.\"\n}\n- Do not make references to YouTube, Spotify, or any other unrelated apps unless they match the active target app.\n- Focus strictly on memory patches, UI manipulation, and Substrate hooking.\n- Reject strictly server-side requests (like spoofing database states or balance adjustments on external servers). Instead, provide an elegant client-side override or bypass logic, and clearly explain why.`;\n\n    const contents = [\n      { role: \"user\", parts: [{ text: `Active chat messages: ${JSON.stringify(chatHistory || [])}\\n\\nLatest user instructions: ${message}` }] }\n    ];\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            explanation: { type: Type.STRING },\n            commandRun: {\n              type: Type.OBJECT,\n              properties: {\n                command: { type: Type.STRING },\n                output: { type: Type.STRING }\n              }\n            },\n            tweakCode: { type: Type.STRING }\n          },\n          required: [\"explanation\", \"tweakCode\"]\n        }\n      }\n    });\n\n    res.json(JSON.parse(response.text || \"{}\"));\n  } catch (err: any) {\n    console.error(err);\n    res.status(500).json({\n      error: \"Failed to query the Gemini intelligence model server.\",\n      details: err.message\n    });\n  }\n});"
      replacement_content: "app.post(\"/api/chat\", async (req, res) => {\n  const { message, chatHistory, ipaMetadata, tweakCode, tweakLanguage, model } = req.body;\n  const aiModel = model || \"gemini-3.5-flash\";\n  \n  try {\n    const systemPrompt = `You are a highly skilled veteran iOS security researcher and dynamic binary manipulation developer.\nYou have absolute expertise working with Mobile Substrate hooking frameworks, LLDB debugging, cycript, and Logos syntax (declarative %hook, %orig, %end, %ctor).\nThe user is working on decompiling and injecting tweaks into the uploaded iOS application package (.ipa).\n\nCurrent Target App Metadata (DO NOT Reference any other app like YouTube or Spotify, only exactly what is below!):\n${JSON.stringify(ipaMetadata || {}, null, 2)}\n\nCurrent Active Code in Editor:\n${tweakCode || \"// Code is empty.\"}\n\nBEHAVIOR RULES:\n1. You must always respond in JSON following this precise schema without any markdown formatting wrappers:\n{\n  \"explanation\": \"A focused, veteran explanation detailing the specific substrate hook or manipulation.\",\n  \"commandRun\": { \"command\": \"grep or class-dump simulation query\", \"output\": \"results retrieved during analysis\" },\n  \"tweakCode\": \"The fully integrated updated tweak code. Maintain and patch the active code in place.\"\n}\n2. The user uploaded their own target binary (metadata provided). Only reference and write hooks for the classes inside the Target App Metadata.\n3. If the user asks you to \"search\", \"find\", or \"grep\" for a specific string or class: populate the commandRun field with a realistic simulated terminal output using the properties and methods genuinely found inside the Target App Metadata. Do not invent properties that are not there, and do not fail the grep command if the data exists.\n4. Keep the \'tweakCode\' field complete so it replaces the file accurately.`;\n\n    const contents = [\n      { role: \"user\", parts: [{ text: `Active chat messages: ${JSON.stringify(chatHistory || [])}\\n\\nLatest user instructions: ${message}` }] }\n    ];\n\n    const response = await ai.models.generateContent({\n      model: aiModel,\n      contents,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            explanation: { type: Type.STRING },\n            commandRun: {\n              type: Type.OBJECT,\n              properties: {\n                command: { type: Type.STRING },\n                output: { type: Type.STRING }\n              }\n            },\n            tweakCode: { type: Type.STRING }\n          },\n          required: [\"explanation\", \"tweakCode\"]\n        }\n      }\n    });\n\n    let payload = {};\n    try {\n      payload = JSON.parse(response.text || \"{}\");\n    } catch (parseError) {\n      // Fallback in case the LLM wrapped it with markdown blocks anyway\n      const cleanedText = (response.text || \"\").replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n      payload = JSON.parse(cleanedText || \"{}\");\n    }\n\n    res.json(payload);\n  } catch (err: any) {\n    console.error(\"Gemini Generation Error:\", err);\n    res.status(500).json({\n      error: \"Failed to query the Gemini intelligence model server.\",\n      details: err.message\n    });\n  }\n});"
    }
