      replacement_content: "import React from \"react\";\nimport { \n  Terminal, ShieldAlert, Cpu, Sparkles, BookOpen, Layers, \n  Code2, ExternalLink, Moon, HelpCircle, CheckCircle, Flame\n} from \"lucide-react\";\nimport { IpaSelector } from \"./components/IpaSelector\";\nimport { TweakChat } from \"./components/TweakChat\";\nimport { TweakEditor } from \"./components/TweakEditor\";\nimport { BinaryInspector } from \"./components/BinaryInspector\";\nimport { ChatMessage, DecompiledClass, IpaMetadata } from \"./types\";\n\nexport default function App() {\n  const [activeIpa, setActiveIpa] = React.useState<IpaMetadata | null>(null);\n  const [isIpaLoading, setIsIpaLoading] = React.useState(false);\n  const [activeClass, setActiveClass] = React.useState<DecompiledClass | null>(null);\n\n  // Chat state\n  const [chatHistory, setChatHistory] = React.useState<ChatMessage[]>([]);\n  const [isChatLoading, setIsChatLoading] = React.useState(false);\n\n  // Editor State\n  const [tweakCode, setTweakCode] = React.useState<string>(`/**\n * TweakStudio Generated logos substrate payload tweak rules.\n * Target: CustomApp\n */\n\n#import <UIKit/UIKit.h>\n\n%hook MainViewController\n\n- (BOOL)jailbreakDetected {\n    NSLog(@\"[TweakStudio] Bypassing secure system filesystem validation checks.\");\n    return NO;\n}\n\n- (BOOL)isLicensed {\n    return YES;\n}\n\n%end\n`);\n  const [tweakLanguage, setTweakLanguage] = React.useState<\"logos\" | \"swift\">(\"logos\");\n\n  // Compiler state\n  const [isCompiling, setIsCompiling] = React.useState(false);\n  const [compileLogs, setCompileLogs] = React.useState<string[]>([]);\n  const [downloadUrl, setDownloadUrl] = React.useState<string | null>(null);\n\n  // Auto trigger default compilation if active ipa loaded or selected\n  const handleIpaLoaded = (metadata: IpaMetadata) => {\n    setActiveIpa(metadata);\n    setActiveClass(metadata.classes[0] || null);\n\n    // Bootstrap first code block\n    let startCode = \"\";\n    if (metadata.bundleName === \"YouTube\") {\n      startCode = `/**\n * TweakStudio - Dynamic Hooking Rules for YouTube v19.18.2\n * Target: com.google.ios.youtube\n */\n\n#import <UIKit/UIKit.h>\n\n%hook YTMainViewController\n\n- (void)viewDidAppear:(BOOL)animated {\n    %orig;\n    NSLog(@\"[TweakStudio] Loaded YTMainViewController successfully.\");\n}\n\n- (BOOL)shouldShowAds {\n    // Disable feeds & inline stream ads\n    return NO;\n}\n\n- (BOOL)isJailbroken {\n    // Override jailbreak detectors\n    return NO;\n}\n\n%end\n\n%hook YTPlaybackData\n- (BOOL)isBackgroundPlaybackAllowed {\n    return YES;\n}\n%end\n`;\n    } else if (metadata.bundleName === \"Spotify\") {\n      startCode = `/**\n * TweakStudio - Spotify Substrate Patch Rules\n * Target: com.spotify.client\n */\n\n#import <UIKit/UIKit.h>\n\n%hook SPTProductState\n\n- (BOOL)boolForKey:(NSString *)key {\n    if ([key isEqualToString:@\"is-premium\"] || [key isEqualToString:@\"premium-user\"]) {\n        return YES; // Bypass premium limits\n    }\n    if ([key isEqualToString:@\"ads-enabled\"] || [key isEqualToString:@\"shuffle-only\"]) {\n        return NO; \n    }\n    return %orig;\n}\n\n%end\n\n%hook SPTSkipLimit\n- (BOOL)canSkip {\n    return YES; // Unlimited skips\n}\n%end\n`;\n    } else if (metadata.bundleName === \"Minecraft\") {\n      startCode = `/**\n * TweakStudio - Minecraft Mobile substrate hooks\n * Target: com.mojang.minecraftpe\n */\n\n%hook LocalPlayer\n\n- (BOOL)isLocalPlayerFlying {\n    return YES; // Flight hack\n}\n\n- (float)reachDistance {\n    return 10.0f; // Extended block interaction distance\n}\n\n- (BOOL)isCreativeMode {\n    return YES; \n}\n\n%end\n`;\n    } else {\n      startCode = `/**\n * TweakStudio - Mobile Substrate Override\n * Target: ${metadata.bundleIdentifier}\n */\n\n#import <UIKit/UIKit.h>\n\n%hook MainViewController\n\n- (BOOL)jailbreakDetected {\n    return NO; // Bypass\n}\n\n- (BOOL)isLicensed {\n    return YES;\n}\n\n%end\n`;\n    }\n\n    setTweakCode(startCode);\n    setChatHistory([]);\n    setDownloadUrl(null);\n    setCompileLogs([]);\n  };\n\n  const handleSelectSnippet = (snippet: string) => {\n    // Prepend or integrate tweak block safely\n    setTweakCode((prev) => prev + \"\\n\" + snippet);\n  };\n\n  const handleSendMessage = async (userMsg: string) => {\n    if (!userMsg.trim() || isChatLoading) return;\n\n    const userMsgObj: ChatMessage = {\n      id: Math.random().toString(),\n      role: \"user\",\n      content: userMsg,\n      timestamp: new Date().toLocaleTimeString()\n    };\n\n    setChatHistory((prev) => [...prev, userMsgObj]);\n    setIsChatLoading(true);\n\n    try {\n      const response = await fetch(\"/api/chat\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          message: userMsg,\n          chatHistory: chatHistory.concat(userMsgObj),\n          ipaMetadata: activeIpa,\n          tweakCode,\n          tweakLanguage\n        })\n      });\n\n      const data = await response.json();\n      if (data.tweakCode) {\n        setTweakCode(data.tweakCode);\n      }\n\n      const assistantMsgObj: ChatMessage = {\n        id: Math.random().toString(),\n        role: \"assistant\",\n        content: data.explanation || \"Hook written safely in pane.\",\n        timestamp: new Date().toLocaleTimeString(),\n        commandRun: data.commandRun || undefined\n      };\n\n      setChatHistory((prev) => [...prev, assistantMsgObj]);\n    } catch (e) {\n      console.error(e);\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          id: Math.random().toString(),\n          role: \"assistant\",\n          content: \"Failed to connect to the Gemini LLM compiler advisor service. Please check process environment.\",\n          timestamp: new Date().toLocaleTimeString()\n        }\n      ]);\n    } finally {\n      setIsChatLoading(false);\n    }\n  };\n\n  const handleCompile = async () => {\n    if (isCompiling || !tweakCode.trim()) return;\n    setIsCompiling(true);\n    setCompileLogs([\"[+] Spinning up compiler sandbox container...\"]);\n    setDownloadUrl(null);\n\n    try {\n      const response = await fetch(\"/api/compile-tweak\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          tweakCode,\n          tweakLanguage,\n          appName: activeIpa?.bundleName || \"CustomApp\"\n        })\n      });\n\n      const data = await response.json();\n      setCompileLogs(data.logs || []);\n      if (data.success) {\n        setDownloadUrl(data.downloadUrl);\n      }\n    } catch (e) {\n      setCompileLogs((prev) => [...prev, \"[ERROR] Critical communication timeout with backend root compiler daemon.\"]);\n    } finally {\n      setIsCompiling(false);\n    }\n  };\n\n  // Auto trigger first load of custom template on layout mount\n  React.useEffect(() => {\n    setIsIpaLoading(true);\n    fetch(\"/api/analyze-ipa\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        fileName: \"YouTube.ipa\",\n        selectedTemplate: \"YouTube.ipa\"\n      })\n    })\n      .then(res => res.json())\n      .then(data => {\n        if (data.metadata) {\n          handleIpaLoaded(data.metadata);\n        }\n      })\n      .catch(err => console.error(err))\n      .finally(() => setIsIpaLoading(false));\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-[#0d1l17] text-gray-100 flex flex-col font-sans selection:bg-indigo-500 selection:text-white leading-normal\">\n      {/* Top Main Navigation Header */}\n      <header className=\"border-b border-gray-800 bg-[#161b22] px-6 py-4 flex items-center justify-between shadow-lg shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2 rounded bg-indigo-600/10 border border-indigo-500/30 text-indigo-400\">\n            <Flame className=\"w-6 h-6 text-indigo-400\" />\n          </div>\n          <div>\n            <h1 className=\"text-lg font-mono font-bold tracking-tight text-white flex items-center gap-2\">\n              TweakStudio <span className=\"text-[10px] bg-red-950 text-red-500 border border-red-900 font-bold px-1.5 py-0.5 rounded uppercase\">ARM64 Research IDE</span>\n            </h1>\n            <p className=\"text-[11px] font-mono text-gray-400\">Conversational iOS IPA Patch & Substrate Compile Injector Suite</p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3 font-mono text-xs text-gray-400\">\n          <span className=\"flex items-center gap-1.5 px-2 py-1 rounded bg-[#0d1117] border border-gray-800\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span>\n            Agent Daemon: Online\n          </span>\n          <span className=\"hidden md:inline px-2 py-1 rounded bg-[#0d1117] border border-gray-800\">\n            Clang SDK: iOS SDK 17.2\n          </span>\n        </div>\n      </header>\n\n      {/* Main Full-Stack Grid Workspace App */}\n      <main className=\"flex-1 p-4 md:p-6 space-y-6 max-w-[1700px] mx-auto w-full flex flex-col min-h-0 overflow-visible\">\n        \n        {/* Top bar ipa selection */}\n        <IpaSelector \n          onIpaLoaded={handleIpaLoaded} \n          isLoading={isIpaLoading}\n          setIsLoading={setIsIpaLoading}\n          activeIpaName={activeIpa ? activeIpa.fileName : \"\"}\n        />\n\n        {activeIpa && (\n          /* Multi-column layout */\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 min-h-[700px]\">\n            \n            {/* Left Pane: Interactive Chatbot assistant */}\n            <div className=\"lg:col-span-4 h-[700px]\">\n              <TweakChat \n                chatHistory={chatHistory}\n                onSendMessage={handleSendMessage}\n                isLoading={isChatLoading}\n                activeIpa={activeIpa}\n              />\n            </div>\n\n            {/* Middle Pane: Real-time code compiler tweak editor */}\n            <div className=\"lg:col-span-4 h-[700px]\">\n              <TweakEditor \n                code={tweakCode}\n                onChange={setTweakCode}\n                language={tweakLanguage}\n                setLanguage={setTweakLanguage}\n                onCompile={handleCompile}\n                isCompiling={isCompiling}\n                compileLogs={compileLogs}\n                downloadUrl={downloadUrl}\n                selectedTemplateName={activeIpa.bundleName}\n              />\n            </div>\n\n            {/* Right Pane: Class headers inspector */}\n            <div className=\"lg:col-span-4 h-[700px]\">\n              <BinaryInspector \n                metadata={activeIpa} \n                onSelectSnippet={handleSelectSnippet}\n                activeClass={activeClass}\n                setActiveClass={setActiveClass}\n              />\n            </div>\n\n          </div>\n        )}\n\n      </main>\n\n      {/* Subtle bottom footer bar */}\n      <footer className=\"border-t border-gray-800 bg-[#0d1117] px-6 py-4 text-center shrink-0\">\n        <p className=\"text-[11px] font-mono text-gray-500\">\n          Designed for iOS dynamic analysis systems & substrate patching simulation hooks. Do not modify remote database schemas.\n        </p>\n      </footer>\n    </div>\n  );\n}\n"
    }
