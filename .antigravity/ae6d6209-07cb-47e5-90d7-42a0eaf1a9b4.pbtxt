    replacement_chunks {
      target_content: "app.post(\"/api/analyze-ipa\", async (req, res) => {\n  const { fileName } = req.body;\n  if (!fileName) {\n    return res.status(400).json({ error: \"Missing uploaded IPA file references.\" });\n  }\n\n  try {\n    const prompt = `You are a professional iOS security dump simulator. The user is uploading or dropping a decrypted iOS application package (.ipa) named: \"${fileName}\".\nSimulate class-dump header injection and decompilation of the Mach-O binary in real-time.\nGenerate a realistic static class dump header structure (bundle identifier, architecture, frameworks, classes, attributes, methods, objective-c selectors) for \"${fileName}\".\nFocus strictly on items of premium interest to developers/security researchers, such as:\n1. License verification variables, VIP status flags, subscription entitlement methods.\n2. Ad display flags, bypass controller logic, skip time delay routines.\n3. Jailbreak indicators, tamper verification, or debugger detectors.\n4. Core UI ViewController states that determine features or limits.\n\nGenerate exactly 3 extremely realistic decompiled classes representing these controllers in this app. Keep it professional. Use correct iOS frameworks (e.g. UIKit, Foundation, AVFoundation, StoreKit, custom framework names).\nReturn exactly this JSON schema, inside raw JSON format (no markdown code blocks, just pure JSON):\n{\n  \"fileName\": \"The exact name of the file uploaded\",\n  \"fileSize\": \"A realistic size based on standard apps e.g. \'84.2 MB\'\",\n  \"bundleIdentifier\": \"A realistic reverse-DNS string e.g. com.developer.app\",\n  \"bundleName\": \"Clean camelcase name e.g. AppName\",\n  \"displayName\": \"Human readable name e.g. App Name\",\n  \"minimumOSVersion\": \"15.0\",\n  \"sdkVersion\": \"17.0\",\n  \"architecture\": [\"arm64\"],\n  \"frameworks\": [\"UIKit.framework\", \"StoreKit.framework\"],\n  \"classes\": [\n    {\n      \"name\": \"Class name, e.g. AppMainViewController or AccountManager\",\n      \"superClass\": \"Base class, e.g. UIViewController or NSObject\",\n      \"protocols\": [\"Protocols adopted, e.g. UITableViewDelegate\"],\n      \"properties\": [\n        {\"name\": \"isPremiumUser\", \"type\": \"BOOL\", \"attributes\": [\"assign\", \"nonatomic\"]}\n      ],\n      \"methods\": [\n        {\n          \"name\": \"isSubscriptionActive\",\n          \"returnType\": \"BOOL\",\n          \"arguments\": [],\n          \"isClassMethod\": false,\n          \"notes\": \"Checks for local subscription files or cached server receipts.\"\n        }\n      ]\n    }\n  ]\n}`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: [{ text: prompt }],"
      replacement_content: "app.post(\"/api/analyze-ipa\", async (req, res) => {\n  const { fileName } = req.body;\n  if (!fileName) {\n    return res.status(400).json({ error: \"Missing uploaded IPA file references.\" });\n  }\n\n  try {\n    const prompt = `You are a professional iOS security dump simulator. The user is uploading or dropping a decrypted iOS application package (.ipa) named: \"${fileName}\".\nSimulate class-dump header injection and decompilation of the Mach-O binary in real-time.\nGenerate a realistic static class dump header structure (bundle identifier, architecture, frameworks, classes, attributes, methods, objective-c selectors) for \"${fileName}\".\nFocus strictly on items of premium interest to developers/security researchers, such as:\n1. License verification variables, VIP status flags, subscription entitlement methods.\n2. Ad display flags, bypass controller logic, skip time delay routines.\n3. Jailbreak indicators, tamper verification, or debugger detectors.\n4. Core UI ViewController states that determine features or limits.\n\nGenerate exactly 5 to 7 extremely realistic decompiled classes representing actual likely controllers in this specific app. Keep it highly professional and plausible. Use correct iOS frameworks (e.g. UIKit, Foundation, AVFoundation, StoreKit, custom framework names like AppCore).\nReturn exactly this JSON schema, inside raw JSON format (no markdown code blocks, just pure JSON):\n{\n  \"fileName\": \"The exact name of the file uploaded\",\n  \"fileSize\": \"A realistic size based on standard apps e.g. \'84.2 MB\'\",\n  \"bundleIdentifier\": \"A realistic reverse-DNS string e.g. com.developer.app\",\n  \"bundleName\": \"Clean camelcase name e.g. AppName\",\n  \"displayName\": \"Human readable name e.g. App Name\",\n  \"minimumOSVersion\": \"15.0\",\n  \"sdkVersion\": \"17.0\",\n  \"architecture\": [\"arm64\"],\n  \"frameworks\": [\"UIKit.framework\", \"StoreKit.framework\"],\n  \"classes\": [\n    {\n      \"name\": \"Class name, e.g. AppMainViewController or AccountManager\",\n      \"superClass\": \"Base class, e.g. UIViewController or NSObject\",\n      \"protocols\": [\"Protocols adopted, e.g. UITableViewDelegate\"],\n      \"properties\": [\n        {\"name\": \"isPremiumUser\", \"type\": \"BOOL\", \"attributes\": [\"assign\", \"nonatomic\"]}\n      ],\n      \"methods\": [\n        {\n          \"name\": \"isSubscriptionActive\",\n          \"returnType\": \"BOOL\",\n          \"arguments\": [],\n          \"isClassMethod\": false,\n          \"notes\": \"Checks for local subscription files or cached server receipts.\"\n        }\n      ]\n    }\n  ]\n}`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-pro-latest\",\n      contents: [{ text: prompt }],"
    }
