  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: \"50mb\" }));\n\n// Initialize Gemini SDK with User-Agent header for telemetry\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY,\n  httpOptions: {\n    headers: {\n      \"User-Agent\": \"aistudio-build\",\n    },\n  },\n});\n\napp.post(\"/api/analyze-ipa\", async (req, res) => {\n  const { fileName } = req.body;\n  if (!fileName) {\n    return res.status(400).json({ error: \"Missing uploaded IPA file references.\" });\n  }\n\n  try {\n    const prompt = `You are a professional iOS security dump simulator. The user is uploading or dropping a decrypted iOS application package (.ipa) named: \"${fileName}\".\nSimulate class-dump header injection and decompilation of the Mach-O binary in real-time.\nGenerate a realistic static class dump header structure (bundle identifier, architecture, frameworks, classes, attributes, methods, objective-c selectors) for \"${fileName}\".\nFocus strictly on items of premium interest to developers/security researchers, such as:\n1. License verification variables, VIP status flags, subscription entitlement methods.\n2. Ad display flags, bypass controller logic, skip time delay routines.\n3. Jailbreak indicators, tamper verification, or debugger detectors.\n4. Core UI ViewController states that determine features or limits.\n\nGenerate exactly 3 extremely realistic decompiled classes representing these controllers in this app. Keep it professional. Use correct iOS frameworks (e.g. UIKit, Foundation, AVFoundation, StoreKit, custom framework names).\nReturn exactly this JSON schema, inside raw JSON format (no markdown code blocks, just pure JSON):\n{\n  \"fileName\": \"The exact name of the file uploaded\",\n  \"fileSize\": \"A realistic size based on standard apps e.g. \'84.2 MB\'\",\n  \"bundleIdentifier\": \"A realistic reverse-DNS string e.g. com.developer.app\",\n  \"bundleName\": \"Clean camelcase name e.g. AppName\",\n  \"displayName\": \"Human readable name e.g. App Name\",\n  \"minimumOSVersion\": \"15.0\",\n  \"sdkVersion\": \"17.0\",\n  \"architecture\": [\"arm64\"],\n  \"frameworks\": [\"UIKit.framework\", \"StoreKit.framework\"],\n  \"classes\": [\n    {\n      \"name\": \"Class name, e.g. AppMainViewController or AccountManager\",\n      \"superClass\": \"Base class, e.g. UIViewController or NSObject\",\n      \"protocols\": [\"Protocols adopted, e.g. UITableViewDelegate\"],\n      \"properties\": [\n        {\"name\": \"isPremiumUser\", \"type\": \"BOOL\", \"attributes\": [\"assign\", \"nonatomic\"]}\n      ],\n      \"methods\": [\n        {\n          \"name\": \"isSubscriptionActive\",\n          \"returnType\": \"BOOL\",\n          \"arguments\": [],\n          \"isClassMethod\": false,\n          \"notes\": \"Checks for local subscription files or cached server receipts.\"\n        }\n      ]\n    }\n  ]\n}`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: [{ text: prompt }],\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            fileName: { type: Type.STRING },\n            fileSize: { type: Type.STRING },\n            bundleIdentifier: { type: Type.STRING },\n            bundleName: { type: Type.STRING },\n            displayName: { type: Type.STRING },\n            minimumOSVersion: { type: Type.STRING },\n            sdkVersion: { type: Type.STRING },\n            architecture: { type: Type.ARRAY, items: { type: Type.STRING } },\n            frameworks: { type: Type.ARRAY, items: { type: Type.STRING } },\n            classes: {\n              type: Type.ARRAY,\n              items: {\n                type: Type.OBJECT,\n                properties: {\n                  name: { type: Type.STRING },\n                  superClass: { type: Type.STRING },\n                  protocols: { type: Type.ARRAY, items: { type: Type.STRING } },\n                  properties: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        type: Type.STRING },\n                        attributes: { type: Type.ARRAY, items: { type: Type.STRING } }\n                      },\n                      required: [\"name\", \"type\"]\n                    }\n                  },\n                  methods: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        returnType: { type: Type.STRING },\n                        arguments: {\n                          type: Type.ARRAY,\n                          items: {\n                            type: Type.OBJECT,\n                            properties: {\n                              name: { type: Type.STRING },\n                              type: Type.STRING }\n                            },\n                            required: [\"name\", \"type\"]\n                          }\n                        },\n                        isClassMethod: { type: Type.BOOLEAN },\n                        notes: { type: Type.STRING }\n                      },\n                      required: [\"name\", \"returnType\"]\n                    }\n                  }\n                },\n                required: [\"name\", \"superClass\", \"properties\", \"methods\"]\n              }\n            }\n          },\n          required: [\"fileName\", \"fileSize\", \"bundleIdentifier\", \"bundleName\", \"classes\"]\n        }\n      }\n    });\n\n    const metadata = JSON.parse(response.text || \"{}\");\n    res.json({ success: true, metadata });\n  } catch (err: any) {\n    console.error(\"Gemini Class dump generation error:\", err);\n    // Safe fall-back metadata matching custom file\n    res.json({\n      success: true,\n      metadata: {\n        fileName,\n        fileSize: \"78.4 MB\",\n        bundleIdentifier: `com.developer.${fileName.toLowerCase().replace(\".ipa\", \"\").replace(/[^a-z0-9]/g, \"\")}`,\n        bundleName: fileName.replace(\".ipa\", \"\"),\n        displayName: fileName.replace(\".ipa\", \"\"),\n        minimumOSVersion: \"14.0\",\n        sdkVersion: \"17.0\",\n        architecture: [\"arm64\"],\n        frameworks: [\"UIKit.framework\"],\n        classes: [\n          {\n            name: \"MainViewController\",\n            superClass: \"UIViewController\",\n            protocols: [],\n            properties: [\n              { name: \"isPremium\", type: \"BOOL\", attributes: [\"assign\", \"readwrite\"] }\n            ],\n            methods: [\n              {\n                name: \"checkSecurityVerification\",\n                returnType: \"BOOL\",\n                arguments: [],\n                isClassMethod: false,\n                notes: \"Returns YES if environment is safe.\"\n              }\n            ]\n          }\n        ]\n      }\n    });\n  }\n});\n\napp.post(\"/api/compile-tweak\", (req, res) => {\n  const { tweakCode, tweakLanguage, appName } = req.body;\n  const logs: string[] = [];\n  logs.push(`[+] Initializing environment variables...`);\n  logs.push(`[+] Found active installation of Theos (THEOS=/opt/theos)`);\n  logs.push(`[+] Loading SDKs for platform \'iPhoneOS\' (iPhoneOS17.2.sdk)`);\n  logs.push(`[*] Preparing build rules for \'Tweak.x\' targeting architecture \'arm64\'`);\n  logs.push(`[*] Compiling: Tweak.x`);\n  \n  if (tweakCode && (tweakCode.includes(\"%hook\") || tweakCode.includes(\"@objc\") || tweakCode.includes(\"import\") || tweakCode.includes(\"func\"))) {\n    logs.push(`[+] Building dynamic library: obj/debug/TweakStudio_${appName}_Tweak.dylib`);\n    logs.push(`[+] Stripping debugging symbols from dylib...`);\n    logs.push(`[*] Patching Mach-O headers of ${appName} using optool...`);\n    logs.push(`[+] Injecting TweakStudio_${appName}_Tweak.dylib payload...`);\n    logs.push(`[+] Packaging customized build container...`);\n    logs.push(`[+] Resigning payloads with ad-hoc certificate...`);\n    logs.push(`[+] Verifying modified layout integrity...`);\n    logs.push(`[SUCCESS] Refactored IPA generated successfully!`);\n    \n    setTimeout(() => {\n      res.json({\n        success: true,\n        logs,\n        downloadUrl: `https://dummy-ios-cdn.local/download/${appName.toLowerCase()}_tweakStudio_patched.ipa`\n      });\n    }, 1800);\n  } else {\n    logs.push(`[!] Build Warning: Missing Logos directive blocks or import statements.`);\n    logs.push(`[ERROR] Compilation failed: No injectables generated.`);\n    setTimeout(() => {\n      res.json({\n        success: false,\n        logs,\n        error: \"Compilation failed: No active hooking code or instructions found.\"\n      });\n    }, 1200);\n  }\n});\n\napp.post(\"/api/chat\", async (req, res) => {\n  const { message, chatHistory, ipaMetadata, tweakCode, tweakLanguage } = req.body;\n  \n  try {\n    const systemPrompt = `You are a highly skilled veteran iOS security researcher and dynamic binary manipulation developer.\nYou have absolute expertise working with Mobile Substrate hooking frameworks, LLDB debugging, cycript, and Logos syntax (declarative %hook, %orig, %end, %ctor).\nThe user is working on decompiling and injecting tweaks into an iOS application package (.ipa).\nCurrent Target App Metadata: ${JSON.stringify(ipaMetadata || {}, null, 2)}\nCurrent Active Code in Editor:\n${tweakCode || \"// Code is empty.\"}\n\nBEHAVIOR RULES:\n- You must always respond in JSON following this absolute schema:\n{\n  \"explanation\": \"A focused, veteran explanation detailing the specific substrate hook or manipulation.\",\n  \"commandRun\": { \"command\": \"grep or class-dump simulation query\", \"output\": \"results retrieved during analysis\" },\n  \"tweakCode\": \"The fully integrated updated tweak code. Do not write duplicate %hook blocks. Maintain and patch the active code in place.\"\n}\n- Do not make references to YouTube, Spotify, or any other unrelated apps unless they match the active target app.\n- Focus strictly on memory patches, UI manipulation, and Substrate hooking.\n- Reject strictly server-side requests (like spoofing database states or balance adjustments on external servers). Instead, provide an elegant client-side override or bypass logic, and clearly explain why.`;\n\n    const contents = [\n      { role: \"user\", parts: [{ text: `Active chat messages: ${JSON.stringify(chatHistory || [])}\\n\\nLatest user instructions: ${message}` }] }\n    ];\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            explanation: { type: Type.STRING },\n            commandRun: {\n              type: Type.OBJECT,\n              properties: {\n                command: { type: Type.STRING },\n                output: { type: Type.STRING }\n              }\n            },\n            tweakCode: { type: Type.STRING }\n          },\n          required: [\"explanation\", \"tweakCode\"]\n        }\n      }\n    });\n\n    res.json(JSON.parse(response.text || \"{}\"));\n  } catch (err: any) {\n    console.error(err);\n    res.status(500).json({\n      error: \"Failed to query the Gemini intelligence model server.\",\n      details: err.message\n    });\n  }\n});\n\n// Serve frontend assets\nif (process.env.NODE_ENV !== \"production\") {\n  import(\"vite\").then(async (viteModule) => {\n    const vite = await viteModule.createServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  });\n} else {\n  const distPath = path.join(process.cwd(), \"dist\");\n  app.use(express.static(distPath));\n  app.get(\"*\", (req, res) => {\n    res.sendFile(path.join(distPath, \"index.html\"));\n  });\n}\n\napp.listen(PORT, \"0.0.0.0\", () => {\n  console.log(`Server is booted and listening on host 0.0.0.0 and port ${PORT}`);\n});\n"
    }
