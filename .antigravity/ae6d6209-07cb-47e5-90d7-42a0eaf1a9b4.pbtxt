  file_change {
    absolute_path_uri: "file:///src/components/TweakChat.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Send, Cpu, Terminal, Sparkles, MessageSquare, Code2, ShieldAlert } from \"lucide-react\";\nimport { ChatMessage, IpaMetadata } from \"../types\";\n\ninterface TweakChatProps {\n  chatHistory: ChatMessage[];\n  onSendMessage: (message: string) => void;\n  isLoading: boolean;\n  activeIpa: IpaMetadata | null;\n}\n\nexport const TweakChat: React.FC<TweakChatProps> = ({\n  chatHistory,\n  onSendMessage,\n  isLoading,\n  activeIpa\n}) => {\n  const [inputText, setInputText] = React.useState(\"\");\n  const chatEndRef = React.useRef<HTMLDivElement>(null);\n\n  React.useEffect(() => {\n    if (chatEndRef.current) {\n      chatEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [chatHistory, isLoading]);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inputText.trim() || isLoading) return;\n    onSendMessage(inputText);\n    setInputText(\"\");\n  };\n\n  const PROMPT_SUGGESTIONS = [\n    { label: \"Bypass Jailbreak Check\", text: \"Hook the main view controller and disable the jailbreak detection check.\" },\n    { label: \"Enable Premium Options\", text: \"Look for user license check variables and hook them to always return true.\" },\n    { label: \"Remove Ads & Video delays\", text: \"Make sure all skip button delays are set to 0 and \'shouldShowAds\' method returns false.\" },\n    { label: \"Always allow background playback\", text: \"Hook isBackgroundPlaybackAllowed to always return YES to unlock premium offline listen options.\" }\n  ];\n\n  return (\n    <div className=\"flex flex-col h-full bg-[#161b22] border border-gray-800 rounded-lg overflow-hidden\">\n      {/* Dynamic Header */}\n      <div className=\"p-3 bg-[#0d1117] border-b border-gray-800 flex items-center gap-2\">\n        <div className=\"p-1 px-1.5 bg-indigo-950 text-indigo-400 border border-indigo-900 rounded font-mono text-xs flex items-center gap-1.5 font-bold\">\n          <MessageSquare className=\"w-4 h-4 text-indigo-400\" /> Veteran iOS Tweak Coach\n        </div>\n        <span className=\"text-xs text-gray-400 font-mono\">\n          Ready to hook and patch classes dynamically.\n        </span>\n      </div>\n\n      {/* Messages history view */}\n      <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-[#0d1117]/40\">\n        {chatHistory.length === 0 ? (\n          <div className=\"h-full flex flex-col justify-center items-center max-w-sm mx-auto text-center space-y-4\">\n            <div className=\"p-4 bg-indigo-950/40 rounded-full border border-indigo-900 text-indigo-400 animate-pulse\">\n              <Sparkles className=\"w-8 h-8\" />\n            </div>\n            \n            <div className=\"space-y-1\">\n              <h4 className=\"font-mono text-sm font-semibold text-gray-200\">Start Your Conversational Tweak</h4>\n              <p className=\"text-xs text-gray-400 font-mono leading-relaxed\">\n                Describe the modification you want. The veteran AI Tweak engineer will auto-write Logos hooks and patch memory.\n              </p>\n            </div>\n\n            {/* Quick Prompts List */}\n            <div className=\"grid grid-cols-1 gap-2 w-full pt-2\">\n              <span className=\"text-[10px] text-gray-500 font-bold uppercase tracking-wider text-left pl-1\">\n                Suggested Patches for {activeIpa?.bundleName || \"CustomApp\"}\n              </span>\n              {PROMPT_SUGGESTIONS.map((s) => (\n                <button\n                  key={s.label}\n                  onClick={() => setInputText(s.text)}\n                  className=\"p-2 bg-[#161b22] hover:bg-[#21262d] border border-gray-800 hover:border-gray-700 rounded text-left font-mono text-[11px] text-gray-300 transition-all flex flex-col gap-0.5\"\n                >\n                  <span className=\"font-semibold text-indigo-300\">{s.label}</span>\n                  <span className=\"text-gray-500 line-clamp-1\">{s.text}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            {chatHistory.map((msg) => (\n              <div\n                key={msg.id}\n                className={`flex flex-col max-w-[85%] ${\n                  msg.role === \"user\" ? \"ml-auto items-end\" : \"mr-auto items-start\"\n                }`}\n              >\n                <div\n                  className={`p-3 rounded-lg text-xs font-mono leading-relaxed select-text ${\n                    msg.role === \"user\"\n                      ? \"bg-indigo-600 text-white rounded-br-none\"\n                      : \"bg-[#161b22] border border-gray-800 text-gray-200 rounded-bl-none\"\n                  }`}\n                >\n                  {msg.content}\n                </div>\n\n                {/* Simulated grep run log block inside assist response */}\n                {msg.role === \"assistant\" && msg.commandRun && msg.commandRun.command && (\n                  <div className=\"w-full mt-1.5 p-2 rounded bg-black/60 border border-gray-900 border-l-2 border-l-cyan-600 font-mono text-[10px] text-gray-400\">\n                    <div className=\"flex items-center gap-1 text-[9px] text-[#58a6ff] pb-1 border-b border-gray-950 mb-1 font-bold\">\n                      <Terminal className=\"w-3 h-3\" /> EXECUTING DISASSEMBLER LOGS\n                    </div>\n                    <div>$ {msg.commandRun.command}</div>\n                    <pre className=\"mt-1 text-gray-500 max-h-24 overflow-y-auto whitespace-pre-wrap select-text\">\n                      {msg.commandRun.output}\n                    </pre>\n                  </div>\n                )}\n                \n                <span className=\"text-[9px] text-gray-600 mt-1 font-mono\">{msg.timestamp}</span>\n              </div>\n            ))}\n\n            {/* Simulated Loading/Skeletons Typing Indicator */}\n            {isLoading && (\n              <div className=\"mr-auto max-w-[85%] flex flex-col items-start gap-2 animate-pulse\">\n                <div className=\"p-3 rounded-lg bg-[#11161d] border border-gray-800 text-xs font-mono text-gray-400 rounded-bl-none flex items-center gap-2\">\n                  <Cpu className=\"w-4 h-4 text-emerald-400 animate-spin\" />\n                  Generating class-dump filters & constructing Substrate hook overrides...\n                </div>\n                \n                {/* Simulated command block running */}\n                <div className=\"p-2 rounded bg-black/60 border border-gray-900 w-64 text-[10px] font-mono text-gray-500\">\n                  <span className=\"text-gray-400 font-semibold\">$ grep -ri \"Jailbreak\" Payload/</span>\n                  <div className=\"h-2 w-12 bg-gray-800 rounded mt-1.5 animate-pulse\" />\n                </div>\n              </div>\n            )}\n            \n            <div ref={chatEndRef} />\n          </div>\n        )}\n      </div>\n\n      {/* Input Message Form */}\n      <form onSubmit={handleSubmit} className=\"p-3 bg-[#0d1117] border-t border-gray-800 shrink-0\">\n        <div className=\"flex items-center gap-2\">\n          <input\n            type=\"text\"\n            placeholder={\n              !activeIpa \n                ? \"Upload or select an IPA above to open chat...\" \n                : \"Ask the iOS Security expert (e.g. \'Bypass ad check mechanisms\')...\"\n            }\n            disabled={!activeIpa || isLoading}\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            className=\"flex-1 bg-[#161b22] border border-gray-800 rounded px-3 py-2 text-xs font-mono text-gray-300 placeholder-gray-500 focus:outline-none focus:border-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!activeIpa || !inputText.trim() || isLoading}\n            className=\"p-2 rounded bg-indigo-600 hover:bg-indigo-500 text-white hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed transition-all shrink-0 cursor-pointer\"\n            title=\"Send Prompts\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
    }
