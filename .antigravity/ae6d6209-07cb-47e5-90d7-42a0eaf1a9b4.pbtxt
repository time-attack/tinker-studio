  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: \"50mb\" }));\n\n// Initialize Gemini SDK with User-Agent header for telemetry\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY,\n  httpOptions: {\n    headers: {\n      \"User-Agent\": \"aistudio-build\",\n    },\n  },\n});\n\n// Mock binaries library for binary simulator headers\nconst MOCK_IPAS: Record<string, any> = {\n  \"YouTube.ipa\": {\n    fileName: \"YouTube_v19.18.2_decrypted.ipa\",\n    fileSize: \"128.4 MB\",\n    bundleIdentifier: \"com.google.ios.youtube\",\n    bundleName: \"YouTube\",\n    displayName: \"YouTube\",\n    minimumOSVersion: \"15.0\",\n    sdkVersion: \"17.2\",\n    architecture: [\"arm64\"],\n    frameworks: [\"UIKit.framework\", \"AVFoundation.framework\", \"Metal.framework\", \"YouTubeCore.framework\"],\n    classes: [\n      {\n        name: \"YTMainViewController\",\n        superClass: \"UIViewController\",\n        protocols: [\"YTResponder\", \"UIGestureRecognizerDelegate\"],\n        properties: [\n          { name: \"adController\", type: \"YTAdController *\", attributes: [\"strong\", \"nonatomic\"] },\n          { name: \"isPremiumUser\", type: \"BOOL\", attributes: [\"assign\", \"readwrite\"] },\n          { name: \"jailbreakDetector\", type: \"YTJailbreakDetector *\", attributes: [\"strong\"] }\n        ],\n        methods: [\n          {\n            name: \"viewDidAppear:\",\n            returnType: \"void\",\n            arguments: [{ name: \"animated\", type: \"BOOL\" }],\n            isClassMethod: false\n          },\n          {\n            name: \"shouldShowAds\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false,\n            notes: \"Determines if video and feed ads should be displayed to the user.\"\n          },\n          {\n            name: \"isJailbroken\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false,\n            notes: \"Performs system calls to check for Cydia, custom paths, and sandbox escapes.\"\n          }\n        ]\n      },\n      {\n        name: \"YTAdController\",\n        superClass: \"NSObject\",\n        protocols: [],\n        properties: [\n          { name: \"skipButtonDelay\", type: \"NSTimeInterval\", attributes: [\"assign\"] },\n          { name: \"adsEnabled\", type: \"BOOL\", attributes: [\"assign\", \"nonatomic\"] }\n        ],\n        methods: [\n          {\n            name: \"playAdVideoWithId:\",\n            returnType: \"void\",\n            arguments: [{ name: \"adVideoId\", type: \"NSString *\" }],\n            isClassMethod: false\n          },\n          {\n            name: \"skipAdImmediate\",\n            returnType: \"void\",\n            arguments: [],\n            isClassMethod: false\n          }\n        ]\n      },\n      {\n        name: \"YTPlaybackData\",\n        superClass: \"NSObject\",\n        protocols: [],\n        properties: [\n          { name: \"isBackgroundPlaybackAllowed\", type: \"BOOL\", attributes: [\"assign\", \"readonly\"] }\n        ],\n        methods: [\n          {\n            name: \"isBackgroundPlaybackAllowed\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false\n          }\n        ]\n      }\n    ]\n  },\n  \"Spotify.ipa\": {\n    fileName: \"Spotify_v8.9.22_Premium_Clean.ipa\",\n    fileSize: \"92.1 MB\",\n    bundleIdentifier: \"com.spotify.client\",\n    bundleName: \"Spotify\",\n    displayName: \"Spotify\",\n    minimumOSVersion: \"14.0\",\n    sdkVersion: \"17.0\",\n    architecture: [\"arm64\", \"arm64e\"],\n    frameworks: [\"UIKit.framework\", \"AudioToolbox.framework\", \"SpotifyService.framework\"],\n    classes: [\n      {\n        name: \"SPTProductState\",\n        superClass: \"NSObject\",\n        protocols: [],\n        properties: [\n          { name: \"overriddenValues\", type: \"NSDictionary *\", attributes: [\"strong\"] }\n        ],\n        methods: [\n          {\n            name: \"stringForKey:\",\n            returnType: \"NSString *\",\n            arguments: [{ name: \"key\", type: \"NSString *\" }],\n            isClassMethod: false\n          },\n          {\n            name: \"boolForKey:\",\n            returnType: \"BOOL\",\n            arguments: [{ name: \"key\", type: \"NSString *\" }],\n            isClassMethod: false,\n            notes: \"Used to check features like \'is-premium\', \'shuffle-only\', \'ads-enabled\'.\"\n          }\n        ]\n      },\n      {\n        name: \"SPTSkipLimit\",\n        superClass: \"NSObject\",\n        protocols: [],\n        properties: [\n          { name: \"remainingSkips\", type: \"NSInteger\", attributes: [\"assign\"] }\n        ],\n        methods: [\n          {\n            name: \"canSkip\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false\n          }\n        ]\n      },\n      {\n        name: \"SPTJailbreakChecker\",\n        superClass: \"NSObject\",\n        protocols: [],\n        properties: [],\n        methods: [\n          {\n            name: \"checkSecurityHardening\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: true\n          }\n        ]\n      }\n    ]\n  },\n  \"Minecraft.ipa\": {\n    fileName: \"Minecraft_v1.20.80_decrypted.ipa\",\n    fileSize: \"340.5 MB\",\n    bundleIdentifier: \"com.mojang.minecraftpe\",\n    bundleName: \"Minecraft\",\n    displayName: \"Minecraft\",\n    minimumOSVersion: \"13.0\",\n    sdkVersion: \"16.4\",\n    architecture: [\"arm64\"],\n    frameworks: [\"UIKit.framework\", \"GLKit.framework\", \"Metal.framework\"],\n    classes: [\n      {\n        name: \"LocalPlayer\",\n        superClass: \"Player\",\n        protocols: [],\n        properties: [\n          { name: \"isFlying\", type: \"BOOL\", attributes: [\"assign\"] },\n          { name: \"reachDistance\", type: \"float\", attributes: [\"assign\"] }\n        ],\n        methods: [\n          {\n            name: \"isLocalPlayerFlying\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false\n          },\n          {\n            name: \"setReachDistance:\",\n            returnType: \"void\",\n            arguments: [{ name: \"distance\", type: \"float\" }],\n            isClassMethod: false\n          },\n          {\n            name: \"isCreativeMode\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false\n          }\n        ]\n      },\n      {\n        name: \"GameSettings\",\n        superClass: \"NSObject\",\n        properties: [\n          { name: \"hasPremiumFeatures\", type: \"BOOL\", attributes: [\"assign\"] }\n        ],\n        protocols: [],\n        methods: []\n      }\n    ]\n  },\n  \"StandardTemplate.ipa\": {\n    fileName: \"CustomApp_decrypted.ipa\",\n    fileSize: \"45.0 MB\",\n    bundleIdentifier: \"com.developer.customapp\",\n    bundleName: \"CustomApp\",\n    displayName: \"CustomApp\",\n    minimumOSVersion: \"14.0\",\n    sdkVersion: \"17.0\",\n    architecture: [\"arm64\"],\n    frameworks: [\"UIKit.framework\"],\n    classes: [\n      {\n        name: \"MainViewController\",\n        superClass: \"UIViewController\",\n        protocols: [],\n        properties: [\n          { name: \"isPremiumStatus\", type: \"BOOL\", attributes: [\"assign\"] }\n        ],\n        methods: [\n          {\n            name: \"jailbreakDetected\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false,\n            notes: \"Checks for the existence of /Applications/Cydia.app etc.\"\n          },\n          {\n            name: \"isLicensed\",\n            returnType: \"BOOL\",\n            arguments: [],\n            isClassMethod: false,\n            notes: \"Performs license check validation with local cache.\"\n          }\n        ]\n      }\n    ]\n  }\n};\n\n// Simulated tool definitions that the chat agent can use to \"search\" binary headers\nconst classDumpAction = (ipaKey: string, query: string) => {\n  const ipa = MOCK_IPAS[ipaKey] || MOCK_IPAS[\"StandardTemplate.ipa\"];\n  if (!query) {\n    return JSON.stringify(ipa.classes, null, 2);\n  }\n  const qStr = query.toLowerCase();\n  const matched = ipa.classes.filter((c: any) => {\n    return (\n      c.name.toLowerCase().includes(qStr) ||\n      c.properties.some((p: any) => p.name.toLowerCase().includes(qStr)) ||\n      c.methods.some((m: any) => m.name.toLowerCase().includes(qStr))\n    );\n  });\n  return matched.length ? JSON.stringify(matched, null, 2) : `No class dump matches found for term \"${query}\"`;\n};\n\n// API routes first\napp.get(\"/api/templates\", (req, res) => {\n  res.json(Object.keys(MOCK_IPAS).map(key => ({\n    key,\n    name: key,\n    bundleIdentifier: MOCK_IPAS[key].bundleIdentifier,\n    fileSize: MOCK_IPAS[key].fileSize\n  })));\n});\n\napp.post(\"/api/analyze-ipa\", (req, res) => {\n  const { fileName, selectedTemplate } = req.body;\n  const ipaKey = selectedTemplate || \"StandardTemplate.ipa\";\n  const data = MOCK_IPAS[ipaKey] || MOCK_IPAS[\"StandardTemplate.ipa\"];\n  \n  // Customise simulation\n  const result = {\n    ...data,\n    fileName: fileName || data.fileName\n  };\n  \n  setTimeout(() => {\n    res.json({ success: true, metadata: result });\n  }, 1500); // 1.5s simulated extraction & header dump\n});\n\napp.post(\"/api/compile-tweak\", (req, res) => {\n  const { tweakCode, tweakLanguage, appName } = req.body;\n  const logs: string[] = [];\n  logs.push(`[+] Initializing environment variables...`);\n  logs.push(`[+] Found active installation of Theos (THEOS=/opt/theos)`);\n  logs.push(`[+] Loading SDKs for platform \'iPhoneOS\' (iPhoneOS17.2.sdk)`);\n  logs.push(`[*] Preparing build rules for \'Tweak.x\' targeting architecture \'arm64\'`);\n  logs.push(`[*] Compiling: Tweak.x`);\n  \n  if (tweakCode.includes(\"%hook\") || tweakCode.includes(\"@objc\") || tweakCode.includes(\"import\")) {\n    logs.push(`[+] Building dynamic library: obj/debug/TweakStudio_${appName}_Tweak.dylib`);\n    logs.push(`[+] Stripping debugging symbols from dylib...`);\n    logs.push(`[*] Patching Mach-O headers of ${appName} using optool...`);\n    logs.push(`[+] Injecting TweakStudio_${appName}_Tweak.dylib payload...`);\n    logs.push(`[+] Packaging customized build container...`);\n    logs.push(`[+] Resigning payloads with ad-hoc certificate...`);\n    logs.push(`[+] Verifying modified layout integrity...`);\n    logs.push(`[SUCCESS] Refactored IPA generated successfully!`);\n    \n    setTimeout(() => {\n      res.json({\n        success: true,\n        logs,\n        downloadUrl: `https://dummy-ios-cdn.local/download/${appName.toLowerCase()}_tweakStudio_patched.ipa`\n      });\n    }, 2800); // Realistic compilation feedback loop time\n  } else {\n    logs.push(`[!] Build Warning: Missing Logos directive blocks or import statements.`);\n    logs.push(`[ERROR] Compilation failed: No injectables generated.`);\n    setTimeout(() => {\n      res.json({\n        success: false,\n        logs,\n        error: \"Compilation failed: No active hooking code or instructions found.\"\n      });\n    }, 2000);\n  }\n});\n\napp.post(\"/api/chat\", async (req, res) => {\n  const { message, chatHistory, ipaMetadata, tweakCode, tweakLanguage } = req.body;\n  \n  try {\n    const systemPrompt = `You are an expert iOS security researcher and veteran iOS tweak developer.\nYou maintain deep expertise in substrate hooking APIs, mobile runtime debugging, Objective-C dynamic dispatch, and Logos rules framework selectors (%hook, %orig, %end).\nYour goal is to converse with the user and automatically maintain and update the active Tweak.x file (Logos) or Swift rewrite.\nIMPORTANT INSTRUCTIONS:\n- You must always respond in JSON following this absolute schema:\n{\n  \"explanation\": \"A short, veteran tone explanation detailing the changes you are recommending and the dynamic library logic.\",\n  \"commandRun\": { \"command\": \"grep or class-dump simulation query\", \"output\": \"results retrieved during analysis\" },\n  \"tweakCode\": \"The fully integrated updated tweak code. Make sure to update, expand, or fix the entire active Tweak code provided, without writing duplicates of hooks.\"\n}\n- Always search class-dump files inside the context of user app headers if relevant!\n- Use exact Objective-C/Swift naming structures. Mention standard headers or protocols.\n- If a user asks for a modification that is strictly server-side (like changing remote database values, billing transactions on external APIs, etc.), gently correct them and suggest a client-side UI/memory check override, or client-side bypass.\n- The user\'s uploaded active IPA metadata is: ${JSON.stringify(ipaMetadata || {}, null, 2)}.\n- The current active tweak code in the editor is:\n${tweakCode || \"// No tweak code written yet.\"}\n\nRespond as a JSON object of exactly: { explanation, commandRun: { command, output }, tweakCode }. Keep the final JSON strictly valid. Ensure it has no markdown around it (just parsable JSON).`;\n\n    const instructions = \"Return only raw JSON that matches the requested output schema.\";\n\n    const contents = [\n      { role: \"user\", parts: [{ text: `Active chat messages: ${JSON.stringify(chatHistory || [])}\\n\\nLatest user instructions: ${message}` }] }\n    ];\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \"application/json\",\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            explanation: { type: Type.STRING, description: \"Your explanation of the tweak hooks.\" },\n            commandRun: {\n              type: Type.OBJECT,\n              properties: {\n                command: { type: Type.STRING, description: \"Command executed, e.g. class-dump\" },\n                output: { type: Type.STRING, description: \"Grep or search results output\" }\n              }\n            },\n            tweakCode: { type: Type.STRING, description: \"The whole single finished tweak code file in Logos %hook syntax.\" }\n          },\n          required: [\"explanation\", \"tweakCode\"]\n        }\n      }\n    });\n\n    res.json(JSON.parse(response.text || \"{}\"));\n  } catch (err: any) {\n    console.error(err);\n    res.status(500).json({\n      error: \"Failed to query the Gemini intelligence model server.\",\n      details: err.message\n    });\n  }\n});\n\n// Serve frontend assets\nif (process.env.NODE_ENV !== \"production\") {\n  import(\"vite\").then(async (viteModule) => {\n    const vite = await viteModule.createServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  });\n} else {\n  const distPath = path.join(process.cwd(), \"dist\");\n  app.use(express.static(distPath));\n  app.get(\"*\", (req, res) => {\n    res.sendFile(path.join(distPath, \"index.html\"));\n  });\n}\n\napp.listen(PORT, \"0.0.0.0\", () => {\n  console.log(`Server is booted and listening on host 0.0.0.0 and port ${PORT}`);\n});\n"
    }
