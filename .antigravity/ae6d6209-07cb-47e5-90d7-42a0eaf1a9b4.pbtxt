  file_change {
    absolute_path_uri: "file:///src/components/TweakEditor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Terminal, Copy, ClipboardCheck, Code2, ShieldAlert, Cpu } from \"lucide-react\";\n\ninterface TweakEditorProps {\n  code: string;\n  onChange: (value: string) => void;\n  language: \"logos\" | \"swift\";\n  setLanguage: (lang: \"logos\" | \"swift\") => void;\n  onCompile: () => void;\n  isCompiling: boolean;\n  compileLogs: string[];\n  downloadUrl: string | null;\n  selectedTemplateName: string;\n}\n\nexport const TweakEditor: React.FC<TweakEditorProps> = ({\n  code,\n  onChange,\n  language,\n  setLanguage,\n  onCompile,\n  isCompiling,\n  compileLogs,\n  downloadUrl,\n  selectedTemplateName\n}) => {\n  const [copied, setCopied] = React.useState(false);\n  const logEndRef = React.useRef<HTMLDivElement>(null);\n\n  React.useEffect(() => {\n    if (logEndRef.current) {\n      logEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [compileLogs]);\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(code);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"flex flex-col h-full bg-[#0d1117] border border-gray-800 rounded-lg overflow-hidden\">\n      {/* Editor Tabs & Top Bar */}\n      <div className=\"flex items-center justify-between px-4 py-2 bg-[#161b22] border-b border-gray-800 shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <Code2 className=\"w-4 h-4 text-emerald-400\" />\n          <span className=\"font-mono text-xs font-semibold text-gray-200\">\n            {language === \"logos\" ? \"Tweak.x\" : \"Tweak.swift\"}\n          </span>\n          <span className=\"text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-900 px-1.5 py-0.5 rounded font-mono\">\n            {selectedTemplateName} Substrate Hook\n          </span>\n        </div>\n\n        {/* Toggle Language Choice */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"inline-flex rounded-md p-0.5 bg-[#0d1117] border border-gray-800\">\n            <button\n              onClick={() => setLanguage(\"logos\")}\n              className={`px-2 py-1 text-[11px] font-mono rounded transition-colors ${\n                language === \"logos\"\n                  ? \"bg-indigo-600 text-white font-semibold\"\n                  : \"text-gray-400 hover:text-gray-200\"\n              }`}\n            >\n              Logos (Objective-C)\n            </button>\n            <button\n              onClick={() => setLanguage(\"swift\")}\n              className={`px-2 py-1 text-[11px] font-mono rounded transition-colors ${\n                language === \"swift\"\n                  ? \"bg-indigo-600 text-white font-semibold\"\n                  : \"text-gray-400 hover:text-gray-200\"\n              }`}\n            >\n              Swift Hooks\n            </button>\n          </div>\n\n          <button\n            onClick={handleCopy}\n            className=\"p-1 px-2 rounded bg-[#21262d] border border-gray-800 hover:bg-[#30363d] text-gray-300 font-mono text-[10px] flex items-center gap-1.5 transition-colors\"\n            title=\"Copy Active Code\"\n          >\n            {copied ? (\n              <>\n                <ClipboardCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                Copied!\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5\" />\n                Copy\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Editor Main Content Area */}\n      <div className=\"flex-1 relative overflow-auto font-mono text-xs p-4 leading-relaxed bg-[#0d1117] min-h-[250px]\">\n        <div className=\"absolute top-4 left-4 select-none pr-3 border-r border-[#21262d] text-[#30363d] text-right space-y-1\">\n          {code.split(\"\\n\").map((_, i) => (\n            <div key={i}>{i + 1}</div>\n          ))}\n        </div>\n\n        <textarea\n          value={code}\n          onChange={(e) => onChange(e.target.value)}\n          spellCheck={false}\n          className=\"w-full h-full bg-transparent text-gray-300 font-mono text-xs focus:outline-none resize-none pl-12 pr-4 leading-relaxed whitespace-pre font-light block\"\n          style={{ fontFamily: \"\'JetBrains Mono\', \'Fira Code\', monospace\" }}\n          placeholder=\"// Conversational iOS Tweak code will automatically generate here...\"\n        />\n      </div>\n\n      {/* Bottom Compiler Panel & Active Build Console */}\n      <div className=\"border-t border-gray-800 bg-[#0d1117] shrink-0 flex flex-col\">\n        {/* Compiler Actions Info */}\n        <div className=\"p-3 bg-[#161b22] flex items-center justify-between border-b border-gray-800\">\n          <div className=\"flex items-center gap-2\">\n            <Terminal className=\"w-4 h-4 text-indigo-400 animate-pulse\" />\n            <span className=\"font-mono text-[11px] font-bold text-gray-400 uppercase tracking-widest\">\n              Theos Compiler Toolchain Output\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={onCompile}\n              disabled={isCompiling || !code.trim()}\n              className={`px-3 py-1.5 rounded text-xs font-mono font-bold flex items-center gap-1.5 transition-all ${\n                isCompiling\n                  ? \"bg-yellow-600/30 text-yellow-300 animate-pulse border border-yellow-800 cursor-not-allowed\"\n                  : !code.trim()\n                  ? \"bg-[#21262d] text-gray-500 border border-gray-800 cursor-not-allowed\"\n                  : \"bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-900/10 cursor-pointer\"\n              }`}\n            >\n              <Cpu className={`w-3.5 h-3.5 ${isCompiling ? \"animate-spin\" : \"\"}`} />\n              {isCompiling ? \"Compiling...\" : \"Compile & Inject\"}\n            </button>\n            \n            {downloadUrl && (\n              <a\n                href={downloadUrl}\n                download\n                className=\"bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded text-xs font-mono font-bold border border-emerald-500 shadow-md shadow-emerald-950/20 transition-all flex items-center gap-1.5\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5\" /> Download Modified IPA\n              </a>\n            )}\n          </div>\n        </div>\n\n        {/* Build Terminal Console Output */}\n        <div className=\"bg-[#090d13] p-3 text-xs font-mono text-gray-400 max-h-40 overflow-y-auto space-y-1 select-text border-b border-gray-950\">\n          {compileLogs.length === 0 ? (\n            <div className=\"text-gray-600 italic\">No output logged. Hit \'Compile & Inject\' to spin up the container toolchain...</div>\n          ) : (\n            compileLogs.map((log, index) => {\n              let color = \"text-gray-400\";\n              if (log.includes(\"[+]\")) color = \"text-indigo-400\";\n              else if (log.includes(\"[*]\")) color = \"text-cyan-400\";\n              else if (log.includes(\"[SUCCESS]\")) color = \"text-emerald-400 font-semibold\";\n              else if (log.includes(\"[ERROR]\")) color = \"text-rose-400 font-semibold\";\n              else if (log.includes(\"[!]\")) color = \"text-amber-400\";\n\n              return (\n                <div key={index} className={`whitespace-pre-wrap ${color}`}>\n                  {log}\n                </div>\n              );\n            })\n          )}\n          <div ref={logEndRef} />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
