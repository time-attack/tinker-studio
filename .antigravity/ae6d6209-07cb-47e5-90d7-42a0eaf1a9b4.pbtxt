    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Upload, Cpu, Smartphone, CheckCircle, AlertTriangle } from \"lucide-react\";\n\ninterface IpaSelectorProps {\n  onIpaLoaded: (metadata: any) => void;\n  isLoading: boolean;\n  setIsLoading: (val: boolean) => void;\n  activeIpaName: string;\n}\n\nexport const IpaSelector: React.FC<IpaSelectorProps> = ({\n  onIpaLoaded,\n  isLoading,\n  setIsLoading,\n  activeIpaName\n}) => {\n  const [dragActive, setDragActive] = React.useState(false);\n  const [typedName, setTypedName] = React.useState(\"\");\n\n  const triggerAnalyze = (fileName: string) => {\n    setIsLoading(true);\n    fetch(\"/api/analyze-ipa\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ fileName })\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.metadata) {\n          onIpaLoaded(data.metadata);\n        }\n      })\n      .catch((err) => console.error(err))\n      .finally(() => setIsLoading(false));\n  };\n\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      const file = e.dataTransfer.files[0];\n      const name = file.name.endsWith(\".ipa\") ? file.name : `${file.name}.ipa`;\n      triggerAnalyze(name);\n    }\n  };\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      const file = e.target.files[0];\n      const name = file.name.endsWith(\".ipa\") ? file.name : `${file.name}.ipa`;\n      triggerAnalyze(name);\n    }\n  };\n\n  const handleManualSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!typedName.trim()) return;\n    const name = typedName.endsWith(\".ipa\") ? typedName : `${typedName}.ipa`;\n    triggerAnalyze(name);\n  };\n\n  return (\n    <div className=\"bg-[#161b22] border border-gray-800 rounded-lg p-5 space-y-4\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-gray-800\">\n        <div>\n          <h2 className=\"text-sm font-mono font-semibold text-gray-200 flex items-center gap-2\">\n            <Smartphone className=\"w-4 h-4 text-indigo-400\" />\n            Target iOS Application Package (.ipa)\n          </h2>\n          <p className=\"text-[11px] text-gray-400 font-mono mt-0.5\">\n            Upload decrypted binary packages to decompile Mach-O symbols & prepare patches.\n          </p>\n        </div>\n\n        {/* Manual search or custom entry */}\n        <form onSubmit={handleManualSubmit} className=\"flex items-center gap-2\">\n          <input\n            type=\"text\"\n            placeholder=\"Type App Name (e.g. Crunchyroll)\"\n            value={typedName}\n            onChange={(e) => setTypedName(e.target.value)}\n            className=\"bg-[#0d1117] border border-gray-800 text-[11px] font-mono text-gray-300 rounded px-3 py-1.5 focus:outline-none focus:border-indigo-500 w-48\"\n          />\n          <button\n            type=\"submit\"\n            className=\"px-3 py-1.5 bg-[#21262d] border border-gray-800 hover:border-gray-700 rounded text-[11px] font-mono text-gray-300 transition-colors\"\n          >\n            Analyze Name\n          </button>\n        </form>\n      </div>\n\n      {/* Upload Drag & Drop View */}\n      <div\n        onDragEnter={handleDrag}\n        onDragOver={handleDrag}\n        onDragLeave={handleDrag}\n        onDrop={handleDrop}\n        className={`relative border-2 border-dashed rounded-lg p-6 py-8 text-center transition-all ${\n          dragActive \n            ? \"border-indigo-500 bg-indigo-950/10\" \n            : \"border-gray-800 bg-[#0d1117]/40 hover:bg-[#0d1117]/60 hover:border-gray-700\"\n        }`}\n      >\n        <input\n          type=\"file\"\n          accept=\".ipa\"\n          onChange={handleFileSelect}\n          className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n        />\n\n        <div className=\"flex flex-col items-center justify-center space-y-2\">\n          {isLoading ? (\n            <div className=\"space-y-2\">\n              <Cpu className=\"w-8 h-8 text-indigo-400 animate-spin mx-auto\" />\n              <div className=\"space-y-0.5\">\n                <p className=\"text-xs font-mono font-semibold text-indigo-400 animate-pulse\">\n                  Decompiling binary layout & symbol tables...\n                </p>\n                <p className=\"text-[10px] text-gray-500 font-mono\">\n                  Performing class-dump header reflection on user upload\n                </p>\n              </div>\n            </div>\n          ) : activeIpaName ? (\n            <div className=\"space-y-2\">\n              <CheckCircle className=\"w-8 h-8 text-emerald-500 mx-auto\" />\n              <div>\n                <p className=\"text-xs font-mono font-semibold text-gray-200\">\n                  Symbol tables extracted: <span className=\"text-emerald-400 font-bold\">{activeIpaName}</span>\n                </p>\n                <p className=\"text-[10px] text-gray-500 font-mono mt-0.5\">\n                  Drag in another .ipa to swap target targets any time.\n                </p>\n              </div>\n            </div>\n          ) : (\n            <>\n              <Upload className=\"w-8 h-8 text-gray-500 mx-auto\" />\n              <p className=\"text-xs font-mono text-gray-300\">\n                Drag and drop decrypted <span className=\"text-indigo-400\">.ipa</span> file here, or click to browse\n              </p>\n              <p className=\"text-[10px] text-gray-500 font-mono\">\n                Decoded symbols and Mach-O descriptors will be generated dynamically in real-time.\n              </p>\n            </>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
