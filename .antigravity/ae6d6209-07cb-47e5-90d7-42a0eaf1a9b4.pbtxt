    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { \n  Terminal, ShieldAlert, Cpu, Sparkles, BookOpen, Layers, \n  Code2, ExternalLink, Moon, HelpCircle, CheckCircle, Flame, Smartphone, Upload\n} from \"lucide-react\";\nimport { IpaSelector } from \"./components/IpaSelector\";\nimport { TweakChat } from \"./components/TweakChat\";\nimport { TweakEditor } from \"./components/TweakEditor\";\nimport { BinaryInspector } from \"./components/BinaryInspector\";\nimport { ChatMessage, DecompiledClass, IpaMetadata } from \"./types\";\n\nexport default function App() {\n  const [activeIpa, setActiveIpa] = React.useState<IpaMetadata | null>(null);\n  const [isIpaLoading, setIsIpaLoading] = React.useState(false);\n  const [activeClass, setActiveClass] = React.useState<DecompiledClass | null>(null);\n\n  // Chat state\n  const [chatHistory, setChatHistory] = React.useState<ChatMessage[]>([]);\n  const [isChatLoading, setIsChatLoading] = React.useState(false);\n\n  // Editor State\n  const [tweakCode, setTweakCode] = React.useState<string>(`/**\n * TweakStudio - Dynamic Hooking Rules\n * Ready to receive target metadata.\n */\n`);\n  const [tweakLanguage, setTweakLanguage] = React.useState<\"logos\" | \"swift\">(\"logos\");\n\n  // Compiler state\n  const [isCompiling, setIsCompiling] = React.useState(false);\n  const [compileLogs, setCompileLogs] = React.useState<string[]>([]);\n  const [downloadUrl, setDownloadUrl] = React.useState<string | null>(null);\n\n  // Triggered when any custom IPA gets dynamically processed\n  const handleIpaLoaded = (metadata: IpaMetadata) => {\n    setActiveIpa(metadata);\n    setActiveClass(metadata.classes[0] || null);\n\n    // Dynamic starter template matching the user\'s specific app methods!\n    const firstClass = metadata.classes[0];\n    const firstMethod = firstClass?.methods[0];\n    \n    let startCode = `/**\n * TweakStudio - Dynamic Substrate Patch Rules\n * Target: ${metadata.bundleIdentifier} (${metadata.displayName})\n */\n\n#import <UIKit/UIKit.h>\n\n`;\n\n    if (firstClass) {\n      startCode += `%hook ${firstClass.name}\\n\\n`;\n      if (firstMethod) {\n        let argsSig = \"\";\n        if (firstMethod.arguments && firstMethod.arguments.length > 0) {\n          argsSig = firstMethod.arguments.map((a: any) => `(${a.type})${a.name}`).join(\" \");\n        }\n        startCode += `${firstMethod.returnType === \"void\" ? \"-\" : \"- \"}(${firstMethod.returnType})${firstMethod.name}${argsSig} {\\n`;\n        if (firstMethod.returnType === \"BOOL\") {\n          startCode += `    return YES; // Override with modified logic\\n`;\n        } else if (firstMethod.returnType === \"void\") {\n          startCode += `    %orig;\\n    NSLog(@\"[TweakStudio] Hooked ${firstMethod.name} selector successfully.\");\\n`;\n        } else {\n          startCode += `    return %orig;\\n`;\n        }\n        startCode += `}\\n\\n`;\n      }\n      startCode += `%end\\n`;\n    } else {\n      startCode += `// No classes matched. Use the chat pane to design memory manipulations for this target.`;\n    }\n\n    setTweakCode(startCode);\n    setChatHistory([]);\n    setDownloadUrl(null);\n    setCompileLogs([]);\n  };\n\n  const handleSelectSnippet = (snippet: string) => {\n    setTweakCode((prev) => prev + \"\\n\" + snippet);\n  };\n\n  const handleSendMessage = async (userMsg: string) => {\n    if (!userMsg.trim() || isChatLoading || !activeIpa) return;\n\n    const userMsgObj: ChatMessage = {\n      id: Math.random().toString(),\n      role: \"user\",\n      content: userMsg,\n      timestamp: new Date().toLocaleTimeString()\n    };\n\n    setChatHistory((prev) => [...prev, userMsgObj]);\n    setIsChatLoading(true);\n\n    try {\n      const response = await fetch(\"/api/chat\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          message: userMsg,\n          chatHistory: chatHistory.concat(userMsgObj),\n          ipaMetadata: activeIpa,\n          tweakCode,\n          tweakLanguage\n        })\n      });\n\n      const data = await response.json();\n      if (data.tweakCode) {\n        setTweakCode(data.tweakCode);\n      }\n\n      const assistantMsgObj: ChatMessage = {\n        id: Math.random().toString(),\n        role: \"assistant\",\n        content: data.explanation || \"Tweaks injected securely into active workspace editor.\",\n        timestamp: new Date().toLocaleTimeString(),\n        commandRun: data.commandRun || undefined\n      };\n\n      setChatHistory((prev) => [...prev, assistantMsgObj]);\n    } catch (e) {\n      console.error(e);\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          id: Math.random().toString(),\n          role: \"assistant\",\n          content: \"Communication failure with LLM advisor. Please ensure variables are loaded correctly.\",\n          timestamp: new Date().toLocaleTimeString()\n        }\n      ]);\n    } finally {\n      setIsChatLoading(false);\n    }\n  };\n\n  const handleCompile = async () => {\n    if (isCompiling || !tweakCode.trim() || !activeIpa) return;\n    setIsCompiling(true);\n    setCompileLogs([\"[+] Allocating sandbox environment...\", \"[+] Reading active dynamic library files...\"]);\n    setDownloadUrl(null);\n\n    try {\n      const response = await fetch(\"/api/compile-tweak\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          tweakCode,\n          tweakLanguage,\n          appName: activeIpa.bundleName || \"CustomApp\"\n        })\n      });\n\n      const data = await response.json();\n      setCompileLogs(data.logs || []);\n      if (data.success) {\n        setDownloadUrl(data.downloadUrl);\n      }\n    } catch (e) {\n      setCompileLogs((prev) => [...prev, \"[ERROR] Compilation server timed out.\"]);\n    } finally {\n      setIsCompiling(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0d1117] text-gray-100 flex flex-col font-sans selection:bg-indigo-600 selection:text-white leading-normal\">\n      {/* Top Professional Header Bar */}\n      <header className=\"border-b border-gray-800 bg-[#161b22] px-6 py-4 flex items-center justify-between shadow-sm shrink-0\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-1.5 rounded bg-indigo-600/10 border border-indigo-500/20 text-indigo-400\">\n            <Flame className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h1 className=\"text-sm font-mono font-bold tracking-tight text-white flex items-center gap-1.5\">\n              TweakStudio\n            </h1>\n            <p className=\"text-[10px] font-mono text-gray-400\">Mobile Substrate Hook Compiler & IPA Injector</p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2 font-mono text-[10px] text-gray-400\">\n          <span className=\"px-2 py-0.5 rounded bg-[#0d1117] border border-gray-800\">\n            THEOS Toolchain v17.2\n          </span>\n        </div>\n      </header>\n\n      {/* Main Full-Stack Grid Workspace */}\n      <main className=\"flex-1 p-4 md:p-6 space-y-6 max-w-[1700px] mx-auto w-full flex flex-col min-h-0 overflow-visible\">\n        \n        {/* Step 1: Upload IPA */}\n        <IpaSelector \n          onIpaLoaded={handleIpaLoaded} \n          isLoading={isIpaLoading}\n          setIsLoading={setIsIpaLoading}\n          activeIpaName={activeIpa ? activeIpa.fileName : \"\"}\n        />\n\n        {activeIpa ? (\n          /* Work Panels Grid */\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 min-h-[640px]\">\n            \n            {/* Left Column: Tweak Chat */}\n            <div className=\"lg:col-span-4 h-[640px]\">\n              <TweakChat \n                chatHistory={chatHistory}\n                onSendMessage={handleSendMessage}\n                isLoading={isChatLoading}\n                activeIpa={activeIpa}\n              />\n            </div>\n\n            {/* Middle Column: Code Editor & Console */}\n            <div className=\"lg:col-span-4 h-[640px]\">\n              <TweakEditor \n                code={tweakCode}\n                onChange={setTweakCode}\n                language={tweakLanguage}\n                setLanguage={setTweakLanguage}\n                onCompile={handleCompile}\n                isCompiling={isCompiling}\n                compileLogs={compileLogs}\n                downloadUrl={downloadUrl}\n                selectedTemplateName={activeIpa.displayName}\n              />\n            </div>\n\n            {/* Right Column: Dynamic Decompiled Symbols Header browser */}\n            <div className=\"lg:col-span-4 h-[640px]\">\n              <BinaryInspector \n                metadata={activeIpa} \n                onSelectSnippet={handleSelectSnippet}\n                activeClass={activeClass}\n                setActiveClass={setActiveClass}\n              />\n            </div>\n\n          </div>\n        ) : (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-12 border border-dashed border-gray-800 rounded-xl bg-[#161b22]/20 text-center space-y-3\">\n            <Smartphone className=\"w-10 h-10 text-gray-600 animate-pulse\" />\n            <div className=\"space-y-1 max-w-sm\">\n              <h3 className=\"font-mono text-xs font-semibold text-gray-200\">Decompiler Workspace Idle</h3>\n              <p className=\"text-[11px] font-mono text-gray-400\">\n                Please drag, upload, or choose an application name above. The system will dynamically generate class headers & spin up the LLM code injector.\n              </p>\n            </div>\n          </div>\n        )}\n\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-gray-800 bg-[#0d1117] py-3 text-center shrink-0\">\n        <p className=\"text-[10px] font-mono text-gray-500\">\n          Dedicated dynamic analysis suite. Memory address patches are ad-hoc signed before packaging inside modified packages.\n        </p>\n      </footer>\n    </div>\n  );\n}\n"
    }
    diff {
